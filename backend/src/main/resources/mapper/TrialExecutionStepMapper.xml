<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.riskstrategy.mapper.TrialExecutionStepMapper">

    <select id="selectByTrialIdOrderByStepNo" resultType="TrialExecutionStep">
        SELECT id, trial_id, step_no, step_title, elapsed_ms
        FROM trial_execution_step
        WHERE trial_id = #{trialId}
        ORDER BY step_no ASC
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.riskstrategy.mapper.P99TrendMapper">

    <select id="selectTop30ByTsAsc" resultType="P99Trend">
        SELECT id, ts, value_ms, slo_ms
        FROM p99_trend
        ORDER BY ts ASC
        LIMIT 30
    </select>

</mapper>
